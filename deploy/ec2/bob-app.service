[Unit]
Description=Bob IDE Node application gateway
Requires=bob-mcp.service docker.service
After=network-online.target bob-mcp.service docker.service

[Service]
Type=simple
User=bob
Group=bob
SupplementaryGroups=docker
WorkingDirectory=/opt/bob-ide
EnvironmentFile=/etc/bob-ide.env
ExecStart=/usr/bin/node /opt/bob-ide/node-server/start.js
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
